# SMTP (Beget)
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.ru
SMTP_PASS=your_password
SENDER_EMAIL=noreply@yourdomain.ru
SENDER_NAME=BidRoute AI

# OpenRouter (Perplexity AI)
OPENROUTER_API_KEY=sk-or-...
PERPLEXITY_MODEL=perplexity/sonar-medium-online

# Parsing
PARSE_INTERVAL_MINUTES=5
UMIT_API_URL=https://umit-prod.purpleplane-it.com/api/v2/bids/

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bidroute.db
